# HELP WANTED runner. Every setting the runner reads is listed here, with its default.
#
# The runner reads its settings from the environment and from nowhere else. For local use, copy this
# file to .env: the pnpm scripts (start, once, status, bootstrap, resume) pass it to Node with
# --env-file-if-exists=.env, which puts it in the environment before the runner starts. .env is
# ignored by git. In Docker and on a hosting platform, set the variables there instead.
#
# With nothing but WORK_ORDERS set, the runner is a DRY RUN: it reads the chain and the IdentityMD
# API, decides what it would do, prints it, and signs and sends nothing.

# The hire desk (the WorkOrders contract). Required.
WORK_ORDERS=

# An Ethereum mainnet RPC. Use a keyed provider: public nodes serve logs only for recent blocks
# (about the last 9,000), so after a day offline a public node can no longer show the runner what
# it missed. The URL is never logged, wherever in it the key sits.
RPC_URL=https://ethereum-rpc.publicnode.com

# The block the desk was deployed in. Required to go live: with it, a runner whose store was lost
# finds every order again, the ones it holds a bond on included.
# START_BLOCK=

# --- Going live: all three are needed. Leave them unset to stay in dry run. -----------------------
# LIVE=1
# RUNNER_PRIVATE_KEY=0x...          # pass it through your secret manager; do not keep it in a file
# (and START_BLOCK, above)

# The request token the protocol asks for: 64 hex characters you make up (openssl rand -hex 32).
# By default the runner makes one and keeps it in the store file. Set it here for any hosted run,
# so that losing the store does not lose it.
# IMD_PAID_TOKEN=

# In a dry run without a key, the address to simulate as (optional).
# RUNNER_ADDRESS=0x...

# In a dry run, also ask the protocol's free preflight what it makes of each job. This is the one
# POST a dry run can be told to make; it costs nothing and creates nothing.
# DRY_RUN_PREFLIGHT=0

# A live run that stops short of the claim: it asks for the quote and the payment challenge of each
# order it would take, runs every check on them, saves the challenge beside the store, and claims
# and signs nothing. For the first look at what the live protocol answers.
# LOOK_ONLY=0

# --- What the runner takes -----------------------------------------------------------------------
# TEMPLATES=skill:research-report   # kinds of job, comma-separated. Also: audit, skill:create-image,
#                                   # skill:create-video. Audits are off by default: the employer
#                                   # names the code, and an audit's record is too large to settle
#                                   # in one transaction (it needs the bonded claim path).
# RECEIPT_ONLY_ORDERS=when-receipts-flow
#                                   # orders that only an on-chain receipt can pay (no bonded claim):
#                                   #   never               take none of them
#                                   #   when-receipts-flow  take them only while IdentityMD's
#                                   #                       WorkRegistry is writing receipts
#                                   #   always              take them and wait for the receipt; the
#                                   #                       bond is lost at the delivery deadline if
#                                   #                       none lands
# RECEIPT_STALL_BLOCKS=1800         # receipts count as stalled when the registry wrote none in this
#                                   # many blocks (1,800 are six hours)
# LATCH_CONDITIONS=1                # send `trigger` for a conditional order whose condition holds,
#                                   # when only its risen price would pay (gas only, no IMD)
# ARBITERS=                         # comma-separated arbiters the runner accepts; none by default
# EMPLOYERS=                        # when set, the only employers whose orders are taken
# MAX_EMPLOYER_LOSSES=1             # lost bonds on one employer's orders before it is left alone
# MIN_ORDER_LIFETIME_SECONDS=7200

# --- Limits on what it can lose (see "What can cost you money" in the README) --------------------
# DAILY_CAP_IMD=2                   # most IMD paid to the swarm per UTC day
# ORDER_CAP_IMD=0.5                 # most IMD paid to the swarm for one order
# MAX_BOND_IMD=0.25                 # largest bond posted for one order (0.25 is the desk's minimum)
# MAX_BONDS_AT_RISK_IMD=1           # most IMD posted as bonds at one time, over all orders held
# MAX_CONCURRENT=2                  # orders held at once
# MIN_MARGIN_IMD=0.05               # what must be left of the runner's pay after the 0.5 IMD fee...
# EXPECTED_FAILURE_BPS=500          # ...and after this share (5%) of bond + fee, kept for failures
# MAX_PAY_FAILURES=2                # payments in a row that end without a job before it stops
#                                   # claiming and waits for `resume`
# MAX_JOBS_PER_ORDER=1              # 2 lets it buy one more job when the first ends blocked and no
#                                   # receipt is on chain (ORDER_CAP_IMD must then cover two fees)

# --- How it behaves ------------------------------------------------------------------------------
# REGISTER_AT_ONCE=0                # 0: register the job once it completed, or 15 minutes before
#                                   # the claim window ends, and give the order back for a tenth
#                                   # of the bond if the job blocks first. 1: register when admitted
# CLAIM_SETTLE_SECONDS=600          # how long the job's newest record must stand before delivery
#                                   # is claimed on it
# MAX_SETTLE_RECORD_BYTES=100000    # larger records are claimed, not carried in a settle
# MAX_SETTLE_GAS=3000000            # the most gas a settle, stamp or reportFailed is sent with. The
#                                   # limit sent comes from an estimate: the desk refuses a
#                                   # settlement unless it is offered about 1.4M gas more than it
#                                   # uses. A record that needs more than this is claimed instead
# STAMP_AFTER_FINALIZE=1            # after a delivery claim was paid unchallenged, mark the order
#                                   # proven (`stamp`) when its receipt lands. No money moves
# STAMP_WATCH_DAYS=30               # how long the receipt is looked for after that
# DISPUTE_TIMEOUT_AFTER_SECONDS=86400
#                                   # a challenged claim nothing decided: how long after the delivery
#                                   # deadline the runner waits for a receipt before it ends the
#                                   # claim itself and takes back nine tenths of its bond
# PREPARED_INPUT_EXTRA_KEYS=        # fields IdentityMD may add, with a value, to the job it prepares
#                                   # from what was sent; a field not listed stops the payment

# --- Gas -----------------------------------------------------------------------------------------
# MAX_FEE_GWEI=3
# MAX_PRIORITY_FEE_GWEI=0.1
# MAX_TX_COST_ETH=0.01              # must cover MAX_SETTLE_GAS at MAX_FEE_GWEI (0.009 ETH by default)
# URGENT_MAX_FEE_GWEI=30            # for the calls that protect a bond: register, release,
# URGENT_MAX_TX_COST_ETH=0.02       # claimDelivered, reportFailed, timeout, and a settle whose
#                                   # delivery deadline is within six hours or whose claim is challenged
# MIN_ETH_BALANCE=0.003             # ETH the wallet must hold before a new order is claimed
# PERMIT2_ALLOWANCE_IMD=5           # what `bootstrap` approves Permit2 for

# --- Stopping ------------------------------------------------------------------------------------
# KILL_SWITCH=1                     # or create the file named by KILL_FILE while it runs
# KILL_FILE=./data/runner.json.KILL

# --- Plumbing ------------------------------------------------------------------------------------
# STORE_PATH=./data/runner.json     # must be on storage that survives a restart
# POLL_SECONDS=60
# CONFIRMATIONS=2
# LOG_CHUNK_BLOCKS=2000
# LOG_LEVEL=info                    # debug, info, warn or error
# IMD_API=https://api.imd.fun
