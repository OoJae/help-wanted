# HELP WANTED keeper. Every setting the keeper reads is listed here, with its default.
#
# The keeper reads its settings from the environment and from nowhere else. For local use, copy this
# file to .env: the pnpm scripts (once, start, status, first-day) pass it to Node with
# --env-file-if-exists=.env, which puts it in the environment before the keeper starts. .env is
# ignored by git. In Docker and on a hosting platform, set the variables there instead.
#
# With nothing but the addresses set, the keeper is a DRY RUN: it reads the chain and the
# IdentityMD API, decides what it would do, prints it, writes the status file, and signs and sends
# nothing.

# --- Launch A: the three contracts the launch created. Required until they are written into
# --- packages/shared/src/deployments.ts, after which they are the default. ------------------------
QUESTIONS=
JOBS_REPORT=
PAYROLL=

# --- Launch B: the hire desk, crowd pots and the Doorbell. Each address switches its module on. ---
# WORK_ORDERS=
# CROWD_POTS=
# DOORBELL=
# START_BLOCK_B=                    # the block launch B was mined in: where the pots' logs are
#                                   # read from (a pot's spec and its contributors are in its logs)

# --- Launch C: rules and endowments. The rules module needs WORK_ORDERS as well. ------------------
# RULES=
# ENDOWMENTS=
# START_BLOCK_C=                    # the block launch C was mined in

# An Ethereum mainnet RPC. A keyed provider is better than a public node: the keeper makes about
# fifty small reads per pass, and a public node serves logs only for about the last 9,000 blocks,
# which the pots and rules modules need more of. The URL is never logged, wherever in it the key sits.
RPC_URL=https://ethereum-rpc.publicnode.com

# --- Going live: both are needed. Leave them unset to stay in dry run. ----------------------------
# LIVE=1
# KEEPER_PRIVATE_KEY=0x...          # pass it through your secret manager; do not keep it in a file.
#                                   # It guards only the ETH the wallet holds for gas: every call the
#                                   # keeper makes is open to anybody.

# In a dry run without a key, the address to simulate as (optional; without it nothing can be
# simulated and the first-day plan cannot check a wallet's IMD).
# KEEPER_ADDRESS=0x...

# --- What runs ------------------------------------------------------------------------------------
# MODULES=questions,jobsReport,payroll   # unset: these three, and every one of desk, pots, doorbell,
#                                        # rules and endowments whose address is given above. Name
#                                        # them to choose, for example MODULES=desk,pots,doorbell
# FEEDS=payrolls,hires,employers         # the house feeds the questions module keeps, in the order
#                                        # they are asked

# --- Limits on what it can spend on gas -----------------------------------------------------------
# MAX_FEE_GWEI=5                    # no transaction is sent while the network asks more than this
# MAX_PRIORITY_FEE_GWEI=0.1
# MAX_TX_COST_ETH=0.02              # the most one transaction may cost (gas limit x fee ceiling). A
#                                   # settlement on the desk is sent with about two million gas
# DAILY_SPEND_CAP_ETH=0.05          # the most gas money spent in one UTC day; then it stops until
#                                   # midnight UTC
# MIN_ETH_BALANCE=0.01              # below this the status file asks for attention; nothing stops

# --- Stopping -------------------------------------------------------------------------------------
# KILL_SWITCH=1                     # or create the file named by KILL_FILE while it runs
# KILL_FILE=./data/keeper.json.KILL

# --- Standing Questions ---------------------------------------------------------------------------
# REQUEST_AT_UTC=14:00              # ask the feeds at this time of day. Unset: as soon as each is
#                                   # due (every 7,000 blocks, which is 23 h 20 min, so the time
#                                   # moves forty minutes earlier each day). Set it to the time of
#                                   # day of the first requests, or a little after.
# TIP_COLLECT_MIN_IMD=0.5           # collect earned tips once they reach this much
# ATTESTATION_EXPIRY_MARGIN_SECONDS=120   # hand a signed answer in only while it has this long left
# CLOSE_ROUNDS_IN_PROGRESS=0        # 1: close a round past its silence deadline (36 h 5 min) though
#                                   # IdentityMD's service still shows its request as being worked
#                                   # on or completing. Off by default: the answer may be on its way
#                                   # and is refused once the round is closed. Turn it on for a
#                                   # round you have decided to give up on, then off again.

# --- The hire desk --------------------------------------------------------------------------------
# The keeper checks every delivery claim against IdentityMD's API. To let it challenge one that is
# untrue, set BOTH of these: a challenge posts the order's bond (0.25 IMD on the Doorbell's orders)
# from the keeper's wallet. With either unset it never challenges; it reports what it found.
# CHALLENGE_FLOAT_IMD=0             # the most IMD posted as challenge bonds at one time
# CHALLENGE_DAILY_CAP_IMD=0         # the most posted in one UTC day
# CHALLENGE_EMPLOYERS=              # comma-separated employers whose orders are defended. Empty: any
#                                   # employer. Set it to the ones you serve (the Doorbell, CrowdPots,
#                                   # Rules, your own wallets): a bond stays posted until the order's
#                                   # delivery deadline, and an employer can be its own runner
# CHALLENGE_ARBITERS=               # arbiters accepted on an order that is challenged. An order with
#                                   # any other arbiter is never challenged; one with none is
# CHALLENGE_CONFIRM_SECONDS=900     # how long a claim must have been seen failing before a challenge
# DESK_OWN_RUNNERS=                 # runners the keeper never evicts or times out: your own
# DESK_FINALIZE=1                   # 0: leave finalizing a checked claim to its runner
# DESK_SETTLE=1                     # 0: leave settling on a receipt to the order's runner
# DESK_MAX_RECORD_BYTES=100000      # larger records are not carried in a settle, stamp or report
# RECEIPT_STALL_BLOCKS=1800         # receipts count as stalled when the WorkRegistry wrote none in
#                                   # this many blocks (six hours); only reported
# STAMP_WATCH_DAYS=30               # how long an order paid on a claim is watched for its receipt

# --- Crowd pots -----------------------------------------------------------------------------------
# POTS_REFUND_BATCH=40              # the most contributors paid in one claimRefunds call
# POTS_REFUND_MIN_IMD=0             # a refund below this is left for its contributor to claim

# --- Rules ----------------------------------------------------------------------------------------
# RULES_HOUSE=                      # rule ids, comma-separated, always fired when they can be
# RULES_IMD_PER_ETH=                # how many IMD one ETH is worth, by your own figure. A rule that
#                                   # is not a house rule is fired only when its tip (in IMD) covers
#                                   # the gas of the fire (in ETH) at this rate. Unset: only house
#                                   # rules are fired
# RULES_TIP_COVER_BPS=10000         # the tip must cover the gas this many times over, in
#                                   # ten-thousandths (10000 is break-even)

# --- Endowments -----------------------------------------------------------------------------------
# ENDOWMENTS_STAKE_MIN_IMD=0.01     # stake once at least this much waits in the buffer
# ENDOWMENTS_HARVEST_MIN_IMD=0.5    # harvest an endowment once this much can be sent to its target

# --- Payroll --------------------------------------------------------------------------------------
# BOOK_MIN_IMD=1                    # book plain transfers once this much is waiting
# DRIP_EVERY_SECONDS=3600           # the least time between two drips (an hourly drip keeps pace)
# FUND_FEEDS_MIN_IMD=1.1            # top the meters up once one is this far below its runway

# --- The first day (see README) -------------------------------------------------------------------
# FIRST_DAY_CONFIRM=0x...           # the plan digest the dry run printed; a live first day needs it
# FIRST_DAY_FUND_PAYROLLS_IMD=      # what to put on each meter. Default: one runway at the live
# FIRST_DAY_FUND_HIRES_IMD=         # cost, which is 7.7, 7.7 and 2.2 IMD at a price of 0.5 IMD.
# FIRST_DAY_FUND_EMPLOYERS_IMD=     # 0 leaves a meter alone.

# --- Plumbing -------------------------------------------------------------------------------------
# STATE_PATH=./data/keeper.json     # today's spending and any transaction in flight; must survive
#                                   # a restart
# STATUS_PATH=./data/keeper-status.json   # written after every run, for a page or an alert
# POLL_SECONDS=300                  # `run` only: the time between two passes
# MAX_ROUNDS=4                      # how often one pass looks again after sending something
# API_MIN_INTERVAL_MS=2100          # the least time between two reads of IdentityMD's API
# RPC_BATCH=1                       # 0: one request per read, for a node that refuses JSON-RPC
#                                   # batches
# MAX_ITEMS_PER_PASS=200            # the most orders, pots, rules and endowments read in one pass
# LOG_LOOKBACK_BLOCKS=8000          # where logs are read from when START_BLOCK_B or _C is not known
# LOG_LEVEL=info                    # debug, info, warn or error
# IMD_API=https://api.imd.fun
