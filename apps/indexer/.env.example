# Every variable is optional. With none set the indexer uses an embedded database in .data/,
# the free public node and the last 7,000 blocks. Never put a private key here: the indexer has
# no use for one.

# --- Storage -----------------------------------------------------------------------------------
# Postgres when set; otherwise PGlite (embedded Postgres) in PGLITE_DIR.
# DATABASE_URL=postgres://user:password@host:5432/indexer
# PGLITE_DIR=.data/pglite

# --- Chain -------------------------------------------------------------------------------------
# One URL, or several separated by commas in order of preference. The free node serves about a
# day of logs; anything older needs a node that keeps history (see "What a full backfill needs").
# RPC_URL=https://ethereum-rpc.publicnode.com
# Where a module begins on its first run: a block number, or -N for N blocks behind the head.
# It applies to the first run only; afterwards the cursor decides (see `backfill` and `skip`).
# START_BLOCK=-7000
# The same for one module: START_BLOCK_RECEIPTS, START_BLOCK_INTAKE, START_BLOCK_FEE_TRANSFERS, ...
# These two are older than the free node serves (about 9,000 blocks): they need a node with history.
# (26142962 is the legacy Intake's creation block; version 2 is younger, so it holds both.)
# START_BLOCK_INTAKE=26142962
# START_BLOCK_FEE_TRANSFERS=-50400
# CHUNK_SIZE=2000
# CONFIRMATIONS=2
# REORG_DEPTH=64
# POLL_INTERVAL_MS=12000

# --- Our own contracts -------------------------------------------------------------------------
# Normally leave all of these unset: the addresses and launch blocks come from the deployments
# book of the shared package (packages/shared/src/deployments.ts), and a launch written there is
# indexed from its block on the next start.
# Set one only to point a module at another contract (a fork, a rehearsal), as
# <address>@<block the contract was deployed in>. The block is required: the module must read the
# contract from its first event, and an address without one is refused at start-up.
# (START_BLOCK_<MODULE>, for example START_BLOCK_WORK_ORDERS, may give the block instead.)
# ADDR_QUESTIONS=0x...@26170000
# ADDR_JOBS_REPORT=
# ADDR_PAYROLL=
# ADDR_WORK_ORDERS=
# ADDR_CROWD_POTS=
# ADDR_DOORBELL=
# ADDR_RULES=
# ADDR_ENDOWMENTS=
# ADDR_ZAP=
# The published list of wallets and contracts the team controls (HOUSE in every count).
# HOUSE_WALLETS_FILE=../../evidence/house-wallets.json

# --- Mirror of the public IdentityMD API -------------------------------------------------------
# API_MIRROR=true
# API_BASE=https://api.imd.fun
# All routes together; values above 19 are refused.
# API_CALLS_PER_MINUTE=12
# Job UUIDs to mirror in full, separated by commas.
# WATCH_JOBS=e9efec16-56f3-40d3-9243-52c453effc7d

# --- Read-only HTTP API ------------------------------------------------------------------------
# HTTP=true
# HOST=127.0.0.1
# PORT=8787

# LOG_LEVEL=info
