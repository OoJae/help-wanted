---
/**
 * A sentence that marks code with backticks, as the Markdown twins write it. The HTML page shows
 * the same sentence with real code spans instead of printing the backticks.
 */
interface Props {
  text: string;
}

const parts = Astro.props.text.split("`");
---

{parts.map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}
