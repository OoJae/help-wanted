---
import Stamp from "~/components/Stamp.astro";
import Layout from "~/layouts/Layout.astro";
import { STATIC_PATHS } from "~/models/registry";

Astro.response.status = 404;
// The address that was asked for, when the server still knows it (a page that answered "no such
// thing" is rewritten here). Printed as text, cut short, never as a link.
const asked = (Astro.originPathname ?? Astro.url.pathname).slice(0, 80);
const named = asked !== "/404" && asked !== "";
---

<Layout title="No such page" description="There is no page at this address." path="/404" noindex>
  <header class="pagehead">
    <div class="lost">
      <div>
        <h1 class="headline">Position not found.</h1>
        <p class="deck">
          There is no page at {named ? <span class="data break">{asked}</span> : "this address"}. Nothing went
          missing on chain; the address is simply not one of ours. Every page that exists is listed below.
        </p>
        <p class="actions">
          <a class="btn" href="/">
            Back to the front page
          </a>
          <a class="btn btn--ghost" href="/verify">
            Check a receipt
          </a>
        </p>
      </div>
      <p class="release__stamp">
        <Stamp stamp={{ text: "NO SUCH PAGE", tone: "void" }} big />
      </p>
    </div>
  </header>
  <ul class="index">
    {STATIC_PATHS.map((p) => (
      <li>
        <a href={p.path}>{p.label}</a>
        <p>{p.blurb}</p>
      </li>
    ))}
  </ul>
</Layout>
