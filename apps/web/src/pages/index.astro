---
import JobCard from "~/components/JobCard.astro";
import OrderCard from "~/components/OrderCard.astro";
import Stamp from "~/components/Stamp.astro";
import Layout from "~/layouts/Layout.astro";
import { REFERENCE_JOB } from "~/config/chain";
import { TEMPLATES } from "~/config/templates";
import { excerpt, formatImd, formatInt, formatUtc } from "~/lib/format";
import { pageData } from "~/lib/page";
import type { StampTone } from "~/models/cards";
import { receiptFlowMeaning } from "~/models/receipts";
import type { WireModel } from "~/models/wire";

const loaded = await pageData<WireModel>(Astro);
if (loaded instanceof Response) return loaded;
const { model: m, meta } = loaded;
const s = m.swarm;
const proofPath = m.proof?.path ?? `/verify/${REFERENCE_JOB.jobId}`;
const proofTone: StampTone = m.proof?.verdict === "proven" ? "proof" : "void";

// The specimen: what an order will look like, set from the audit order form's own defaults. It is
// drawn only while the deployments book holds no address for the hire desk, and it is marked as a
// specimen in the page.
const specimen = TEMPLATES[0];
const specimenText = specimen
  ? excerpt(
      specimen.spec(
        Object.fromEntries(specimen.slots.filter((x) => x.required).map((x) => [x.name, x.placeholder])),
      ),
      150,
    )
  : "";

// The newest jobs are shown; the rest of the list folds away under them.
const FIRST = 12;
const firstJobs = m.jobs.cards.slice(0, FIRST);
const moreJobs = m.jobs.cards.slice(FIRST);
---

<Layout title={meta.title} description={meta.description} sources={m.sources} generatedAt={m.generatedAt}>
  <header class="pagehead">
    <div class="lead">
      <div>
        <h1 class="headline headline--wide">{m.headline}</h1>
        <p class="deck">
          {s
            ? `The other ${formatInt(s.idle)} machines in IdentityMD's swarm are waiting. HELP WANTED is where contracts hire them: a contract posts a job, a robot does it, and the money moves when the work is proven on chain. Nothing softer pays unless the employer chose it.`
            : "IdentityMD's public API did not answer just now. The rest of this page shows what could be read."}
        </p>
        <p class="actions">
          <a class="btn" href={proofPath}>
            Watch a receipt check
          </a>
          <a class="btn btn--ghost" href="/judges">
            For judges
          </a>
        </p>
      </div>
      <aside class="proofcard" aria-label="One job, checked for this page">
        {m.proof ? (
          <>
            <p class="proofcard__stamp">
              <a href={m.proof.path} aria-label={`${m.proof.stamp}: see the whole check`}>
                <Stamp stamp={{ text: m.proof.stamp, tone: proofTone }} big />
              </a>
            </p>
            <p>
              <strong>
                Job <span class="data">{m.proof.jobId.slice(0, 8)}</span>, checked for this page.
              </strong>{" "}
              {m.proof.summary}
            </p>
            <p class="small">
              {m.proof.receiptReadAt && <>Registry read {formatUtc(m.proof.receiptReadAt)}. </>}
              <a href={m.proof.path}>Every step, repeated in your browser</a>
            </p>
          </>
        ) : (
          <>
            <p>
              <strong>The check behind every payment.</strong> A job's work record is hashed and compared with
              the receipt Ethereum holds for it.
            </p>
            <p class="small">
              The reference job could not be checked in time for this page.{" "}
              <a href={proofPath}>Run the check now</a>
            </p>
          </>
        )}
      </aside>
    </div>
    {s ? (
      <dl class="figures">
        {s.acceptedLastDay !== null && (
          <div class="figure">
            <dt>Pieces of work accepted in 24 hours</dt>
            <dd>{formatInt(s.acceptedLastDay)}</dd>
          </div>
        )}
        {s.paidOrders !== null && (
          <div class="figure">
            <dt>Paid orders, all time</dt>
            <dd>{formatInt(s.paidOrders)}</dd>
          </div>
        )}
        {s.receiptsQueued !== null && (
          <div class="figure">
            <dt>Receipts waiting to go on chain</dt>
            <dd>{formatInt(s.receiptsQueued)}</dd>
          </div>
        )}
        <div class="figure">
          <dt>Price of one swarm job</dt>
          <dd>
            {formatImd(m.paidActionPriceWei)} <small>IMD</small>
          </dd>
        </div>
      </dl>
    ) : (
      <p class="notice notice--quiet small" style="margin-top:1.4rem">
        The swarm's state could not be read: {m.swarmError}
      </p>
    )}
    {s?.computedAt && (
      <p class="small" style="margin:0.6rem 0 0">
        The swarm's own figures, as IdentityMD's API computed them at {formatUtc(s.computedAt)}.
      </p>
    )}
  </header>

  <section class="section section--first" aria-labelledby="ours">
    <div class="section__head">
      <h2 id="ours">Orders on our desk</h2>
      <p>
        {m.ourOrders.launched
          ? `${m.ourOrders.count === null ? "the count could not be read just now" : `${m.ourOrders.count} opened so far`} · each labelled HOUSE (ours) or OUTSIDE`
          : "the hire desk is not launched yet"}
      </p>
    </div>
    {m.ourOrders.cards.length > 0 ? (
      <div class="classifieds">
        {m.ourOrders.cards.map((card) => (
          <OrderCard card={card} />
        ))}
      </div>
    ) : m.ourOrders.launched && m.ourOrders.count === null ? (
      <p class="notice notice--quiet">
        The hire desk is at <span class="break data">{m.desk.address}</span>, but its orders could not be read
        just now. Nothing is said here about them until it answers.
      </p>
    ) : m.ourOrders.launched ? (
      <div class="classifieds">
        <div class="ad ad--blank">
          <p class="ad__head">This space for hire.</p>
          {m.ourOrders.count === 0 ? (
            <p>
              The hire desk is live at <span class="break data">{m.desk.address}</span> and nobody has posted
              an order: its own counter read 0 for this page. <a href="/hire">Post the first one.</a>
            </p>
          ) : (
            <p>
              The hire desk is live at <span class="break data">{m.desk.address}</span>. None of its newest
              orders could be read as an order just now. <a href="/orders">Every order.</a>
            </p>
          )}
        </div>
      </div>
    ) : (
      <figure class="specimen">
        {specimen && (
          <div class="ad" aria-label="A specimen order card">
            <p class="ad__head">
              <span>HELP WANTED:</span> <span>{specimen.staff}.</span>
            </p>
            <p class="ad__pay">
              Pay up to {specimen.suggestedMaxPay} IMD. <span>Employer: a contract.</span>
            </p>
            <p class="ad__text">{specimenText}</p>
            <div class="ad__foot">
              <p class="ad__meta">Set from the audit order form</p>
              <Stamp stamp={{ text: "SPECIMEN", tone: "void" }} />
            </div>
          </div>
        )}
        <figcaption>
          <p class="ad__head">No orders yet, and none made up.</p>
          <p>
            The hire desk (WorkOrders, launch B) is not launched. The card beside this is a specimen: how an
            order will read, set from the site's own audit order form. A real one later carries its stamp:
            FILLED, PROVEN ON CHAIN or REFUNDED.
          </p>
          <p class="ad__links">
            <a href="/hire">What an order is</a>
            <a href="/judges#not-live">What is live today</a>
          </p>
        </figcaption>
      </figure>
    )}
    {m.ourOrders.error && <p class="small spot">The desk could not be read just now: {m.ourOrders.error}</p>}
  </section>

  <section class="section" aria-labelledby="how">
    <div class="section__head">
      <h2 id="how">How a contract hires a robot</h2>
      <p>
        <a href="/judges">every claim, with its check</a>
      </p>
    </div>
    <ol class="steps steps--across">
      <li class="step step--open">
        <div>
          <h3 class="step__title">Escrow against a pinned job</h3>
          <p class="step__detail">
            An employer (a wallet, a contract or a crowd pot) puts IMD in escrow and pins the job text. A rule
            can hold the order shut until a line is crossed: <a href="/rules/new">say when</a>.
          </p>
        </div>
      </li>
      <li class="step step--open">
        <div>
          <h3 class="step__title">A bonded runner opens it</h3>
          <p class="step__detail">
            A runner posts a bond, pays the swarm's {formatImd(m.paidActionPriceWei)} IMD, and opens the job
            with the order's ticket as the first bytes of its text.{" "}
            <a href="/runners">Anyone can be a runner.</a>
          </p>
        </div>
      </li>
      <li class="step step--open">
        <div>
          <h3 class="step__title">Paid on proof, or refunded</h3>
          <p class="step__detail">
            The escrow pays when the job's work record hashes to the receipt in IdentityMD's WorkRegistry.{" "}
            <a href={proofPath}>See that check run</a> on a real job. An employer may also choose to accept a
            bonded delivery claim that nobody challenges for 24 hours; that choice and its limits are spelled
            out on <a href="/hire">the hire desk</a>. No delivery, refund.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section class="section" aria-labelledby="swarm">
    <div class="section__head">
      <h2 id="swarm">Elsewhere in the swarm</h2>
      <p>
        {m.jobs.cards.length === 0 && m.jobs.error
          ? "the job list could not be read just now"
          : `newest ${m.jobs.cards.length} jobs, oracle panels left out · ${m.jobs.finished} finished · ${m.jobs.atWork} at work · ${m.jobs.withReceipt} with a receipt on chain`}
      </p>
    </div>
    <p>
      These jobs did not come through HELP WANTED; they are what the swarm is being paid to do today. Each
      text is the customer's own, cut short. A finished job is stamped FILLED; if IdentityMD's WorkRegistry
      holds a receipt for it, RECEIPT ON CHAIN. <a href="/verify">Check any of them yourself.</a>
    </p>
    <p class="small">
      Receipts, as read for this page: {m.receipts.observed} {receiptFlowMeaning(m.receipts)}
    </p>
    {m.jobs.cards.length > 0 ? (
      <>
        <div class="classifieds">
          {firstJobs.map((card) => (
            <JobCard card={card} />
          ))}
        </div>
        {moreJobs.length > 0 && (
          <details class="plain">
            <summary>
              {moreJobs.length} more job{moreJobs.length === 1 ? "" : "s"}, older
            </summary>
            <div class="classifieds">
              {moreJobs.map((card) => (
                <JobCard card={card} />
              ))}
            </div>
          </details>
        )}
      </>
    ) : (
      <p class="notice notice--quiet">
        The job list could not be read just now{m.jobs.error ? `: ${m.jobs.error}` : "."}
      </p>
    )}
  </section>
</Layout>
