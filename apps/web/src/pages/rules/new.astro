---
import Commands from "~/components/Commands.astro";
import FlowBlock from "~/components/FlowBlock.astro";
import NotLaunched from "~/components/NotLaunched.astro";
import QrCode from "~/components/QrCode.astro";
import RingStrip from "~/components/RingStrip.astro";
import Layout from "~/layouts/Layout.astro";
import { pageData } from "~/lib/page";
import type { RulesNewModel } from "~/models/money";

const loaded = await pageData<RulesNewModel>(Astro);
if (loaded instanceof Response) return loaded;
const { model: m, meta } = loaded;
// The Doorbell's rings since its last 25th, from rings() as read for this page; null when unread.
const rings = m.doorbellState?.rings ?? null;
const sinceHire = rings === null ? null : rings % 25;
---

<Layout title={meta.title} description={meta.description} sources={m.sources} generatedAt={m.generatedAt}>
  <header class="pagehead">
    <h1 class="headline headline--wide">When a line is crossed, then hire.</h1>
    <p class="deck">
      Write one sentence: WHEN a contract's view call or a Standing Question crosses a line, THEN hire the
      swarm or pay. There are two ways to say it:
    </p>
    {/* The two ways are a choice between two things, so they are set as one, a short list. */}
    <ul class="deck deck--list">
      <li>once, as an order nobody can take until its condition has been seen true, or</li>
      <li>as a standing rule that holds its own escrow and fires as often as you allow.</li>
    </ul>
  </header>

  <NotLaunched contract={m.desk} consequence="No rule can be written today." />

  <section class="section section--first" id="once">
    <div class="section__head">
      <h2>Once: start from a sentence</h2>
      <p>a preset fills the form below</p>
    </div>
    <div class="classifieds">
      {m.presets.map((p) => (
        <article class="ad">
          <h3 class="ad__head">
            <a href={`/rules/new?preset=${p.slug}`}>{p.title}</a>
          </h3>
          <p class="ad__text">{p.sentence}</p>
          <div class="ad__foot">
            <p class="ad__links">
              <a href={`/rules/new?preset=${p.slug}`}>Use this sentence</a>
            </p>
            {m.activePreset === p.slug && <span class="status">Chosen</span>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>Write the rule</h2>
      <p>an order with a condition, on the hire desk</p>
    </div>
    <FlowBlock flow={m.flow} exampleNote="an example that watches the IMD token itself" />
  </section>

  <section class="section">
    <div class="section__head">
      <h2>How it works</h2>
      <p>once true, always open</p>
    </div>
    <div class="cols cols--ruled">
      <ol>
        {m.how.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <div>
        <h3 class="sub sub--first">The limits</h3>
        <ul>
          {m.limits.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="standing">
    <div class="section__head">
      <h2>A standing rule: fires more than once</h2>
      <p>Rules · {m.rules.label}</p>
    </div>
    {m.rules.address ? (
      <p>
        Rules is at{" "}
        <a class="data break" href={m.rules.url} rel="noopener">
          {m.rules.address}
        </a>
        .{" "}
        {m.ruleCount === null
          ? "How many rules have been created could not be read just now."
          : `${m.ruleCount} rule${m.ruleCount === 1 ? " has" : "s have"} been created.`}
      </p>
    ) : (
      <p class="notice notice--quiet">
        <strong>Standing rules cannot be written yet: Rules (launch C) is not launched yet.</strong> The form
        below is complete and shows the exact transaction and its cast command.
      </p>
    )}
    {m.rulesError && <p class="small spot">Rules could not be read just now: {m.rulesError}</p>}
    {m.ruleRows.length > 0 && (
      <div class="tablewrap">
        <table class="wide stack">
          <caption>Rules that exist, newest first</caption>
          <thead>
            <tr>
              <th>Rule</th>
              <th>Sentence</th>
              <th class="num">Escrow, IMD</th>
              <th class="num">Tip, IMD</th>
              <th>Fires</th>
              <th>Now</th>
            </tr>
          </thead>
          <tbody>
            {m.ruleRows.map((row) => (
              <tr>
                <th scope="row">#{row.id}</th>
                <td class="break" data-label="Sentence">
                  {row.sentence}
                </td>
                <td class="num" data-label="Escrow, IMD">
                  {row.escrowImd}
                </td>
                <td class="num" data-label="Tip, IMD">
                  {row.tipImd}
                </td>
                <td data-label="Fires">{row.fires}</td>
                <td data-label="Now">{row.ready}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {m.firstRule && (
      <>
        <p>{m.firstRule.words}</p>
        <p class="small">
          {m.firstRule.links.map((l, index) => (
            <>
              {index > 0 && " · "}
              <a href={l.url} rel={l.url.startsWith("http") ? "noopener" : undefined}>
                {l.label}
              </a>
            </>
          ))}
        </p>
      </>
    )}
    <div class="cols cols--ruled">
      <ol>
        {m.ruleHow.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <div>
        <h3 class="sub sub--first">The limits</h3>
        <ul>
          {m.ruleLimits.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    </div>
    <h3 class="sub">Write one</h3>
    <p>
      The example is a rule on a view call, the one launch C's launch document gives in section 6: when the
      IMD staked in sIMD reaches two million, hire a report on who staked it. The fire and reconcile examples
      name rule 1 as it is on mainnet: its job text, and order 2, the order it opened.
    </p>
    <FlowBlock
      flow={m.ruleFlow}
      exampleNote="a rule on a view call, from launch C's launch document"
      repeat
      above={[m.flow]}
    />
    <h3 class="sub">Fire, reconcile, cancel</h3>
    {m.ruleFlows.map((flow) => (
      <FlowBlock flow={flow} exampleNote="rule 1" repeat above={[m.flow, m.ruleFlow]} />
    ))}
    <h3 class="sub">Read a rule</h3>
    <Commands commands={m.commands} />
  </section>

  <section class="section" id="doorbell">
    <div class="section__head">
      <h2>The Doorbell: a rule you can ring</h2>
      <p>Doorbell · {m.doorbell.label}</p>
    </div>
    <p>{m.doorbellIntro}</p>
    {m.doorbellNext && <p class="bellnext">{m.doorbellNext}</p>}
    {m.ringCost && <p class="small">{m.ringCost}</p>}

    {/* Ringing is one step: the wallet form first, then the same call as a link for a phone. */}
    <FlowBlock flow={m.ringFlow} repeat />

    {m.ringPhone && (
      <div class="ringphone">
        <div class="ringphone__words">
          <h3 class="sub sub--first">On a phone</h3>
          <p>{m.ringPhone.words}</p>
          <p class="actions">
            <a class="btn btn--ghost" href={m.ringPhone.url}>
              {m.ringPhone.key}
            </a>
          </p>
          <p class="small ringphone__link">
            <code class="break">{m.ringPhone.url}</code>
          </p>
          <p class="small">{m.ringPhone.note}</p>
        </div>
        <figure class="ringphone__code">
          <QrCode text={m.ringPhone.url} label={m.ringPhone.qrLabel} />
        </figure>
      </div>
    )}

    <h3 class="sub">Where it stands</h3>
    {m.doorbellState ? (
      <div class="doorbell-read">
        {sinceHire !== null && <RingStrip rung={sinceHire} />}
        <ul>
          {m.doorbellFacts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      </div>
    ) : m.doorbell.address ? (
      <p class="small spot">
        The Doorbell could not be read just now{m.doorbellError ? `: ${m.doorbellError}` : ""}. Nothing is
        said here about its rings, its money or how its orders pay until it answers.
      </p>
    ) : (
      <p class="small">
        Whether its orders accept a bonded delivery claim is fixed when it is launched, by whether
        IdentityMD's receipts are arriving that day, and will be printed here.
      </p>
    )}

    {m.doorbellWho && (
      <>
        <h3 class="sub">Who rang</h3>
        {m.doorbellWho.words && <p>{m.doorbellWho.words}</p>}
        {m.doorbellWho.listWords && <p>{m.doorbellWho.listWords}</p>}
        {m.doorbellWho.outside.length > 0 && (
          <ul class="ringers">
            {m.doorbellWho.outside.map((r) => (
              <>
                {/* prettier-ignore */}
                <li><a class="addr" href={r.url} rel="noopener">{r.short}</a>{r.words.slice(r.short.length)} (<a href={r.txUrl} rel="noopener">its transaction</a>)</li>
              </>
            ))}
          </ul>
        )}
      </>
    )}
    {m.doorbellState && (
      <p class="small">
        <a href="/judges#limit-B-D1">{m.doorbellLimits}</a>
      </p>
    )}
  </section>
</Layout>
