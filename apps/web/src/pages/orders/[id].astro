---
import Commands from "~/components/Commands.astro";
import FlowBlock from "~/components/FlowBlock.astro";
import NotLaunched from "~/components/NotLaunched.astro";
import Stamp from "~/components/Stamp.astro";
import Theirs from "~/components/Theirs.astro";
import TimeCard, { type TimeCardOrder } from "~/components/TimeCard.astro";
import Layout from "~/layouts/Layout.astro";
import { formatDuration, formatUtc } from "~/lib/format";
import { pageData } from "~/lib/page";
import { sentenceCase } from "~/lib/stamp";
import type { OrderModel } from "~/models/desk";

const loaded = await pageData<OrderModel>(Astro);
if (loaded instanceof Response) return loaded;
const { model: m, meta } = loaded;
const o = m.order;
const c = m.card;
// The timeline's step names arrive in capitals ("JOB OPENED"), as the twins print them. On the page
// they are labels, set in sentence case like every other label.
const stepName = (label: string) => sentenceCase(label);

// ---- The transaction trail, printed as the order's own time card. ----
const first = m.trail[0];
const last = m.trail[m.trail.length - 1];
const opened = m.trail.find((x) => x.key === "opened");
const settled = m.trail.find((x) => x.key === "settled");
// "16 Oct 2026"; a card that runs over two days says both: "13 to 14 Oct 2026".
const dayOf = (iso: string) => formatUtc(iso).split(", ")[0] ?? "";
const span = (from: string, to: string) => {
  const [a, b] = [dayOf(from), dayOf(to)];
  if (a === b) return a;
  const [ad, am, ay] = a.split(" ");
  const [bd, bm, by] = b.split(" ");
  if (ay !== by) return `${a} to ${b}`;
  return am === bm ? `${ad} to ${bd} ${bm} ${by}` : `${ad} ${am} to ${bd} ${bm} ${by}`;
};
const timeCard: TimeCardOrder | null =
  first && last
    ? {
        id: m.id,
        path: null,
        day: span(first.at, last.at),
        note: null,
        lines: m.trail.map((x) => ({
          key: x.key,
          label: x.label,
          at: x.at,
          block: x.block,
          what: x.what,
          tx: x.tx,
          txUrl: x.txUrl,
        })),
        total: opened && settled ? formatDuration(Date.parse(settled.at) - Date.parse(opened.at)) : null,
        after: [],
        // Red only where the desk's live read says Delivered and proven, as on the front page's card.
        proven: c?.stamp?.tone === "proof",
        origin: c?.origin ?? "HOUSE",
      }
    : null;
---

<Layout title={meta.title} description={meta.description} sources={m.sources} generatedAt={m.generatedAt}>
  <header class="pagehead">
    <p class="crumbs">
      <a href="/orders">Orders</a> · order {m.id}
      {c && (
        <>
          {" "}
          · <span class:list={["tag", c.origin === "HOUSE" && "tag--solid"]}>{c.origin}</span>
        </>
      )}
      {c?.sample && (
        <>
          {" "}
          <span class="tag tag--spot">SAMPLE</span>
        </>
      )}
    </p>
    <div class="lost">
      <div>
        <h1 class="headline headline--small">
          {c
            ? `${c.headline} ${c.pay} ${c.employerWords}`
            : m.launched
              ? `Order ${m.id} could not be read just now.`
              : `Order ${m.id} does not exist yet.`}
        </h1>
        <p class="deck">{m.statusWords}</p>
        {m.picture && (
          <p class="actions">
            <a class="btn btn--ghost" href={m.picture.url} rel="noopener">
              {m.picture.label}
            </a>
          </p>
        )}
        {m.work && (
          <p class="actions">
            <a class="btn btn--ghost" href={m.work.url} rel="noopener">
              {m.work.label}
            </a>
          </p>
        )}
      </div>
      {c?.stamp && (
        <p class="release__stamp">
          {/* Named for the page change: the stamp on this order's card travels into this one. */}
          <Stamp stamp={c.stamp} big name={`order-${m.id}-stamp`} />
        </p>
      )}
    </div>
  </header>

  <NotLaunched contract={m.desk} consequence="No order exists on chain." />
  {m.error && <p class="small spot">The desk could not be read just now: {m.error}</p>}

  {o && (
    <section class="section section--first">
      <div class="section__head">
        <h2>Timeline</h2>
        <p>posted, taken, job opened, delivered, proven</p>
      </div>
      <ol class="timeline">
        {m.timeline.map((step) => (
          <li data-at={step.at}>
            <span class="label">{stepName(step.label)}</span>
            <p>{step.detail}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {/* The chain's own record of the order comes next, before its terms: what happened, then what
       was agreed. */}
  {m.trail.length > 0 && (
    <section class="section" id="trail">
      <div class="section__head">
        <h2>The transaction trail</h2>
        <p>{m.trail.length} transactions, oldest first</p>
      </div>
      {m.trailNote && <p class="small">{m.trailNote}</p>}
      {/* The order's own time card: one line a transaction, printed once as it comes into view. */}
      <TimeCard order={timeCard} stamp={c?.stamp ?? null} notes print />
    </section>
  )}

  {o && (
    <>
      <section class="section">
        <div class="section__head">
          <h2>The order</h2>
          <p>read from the desk</p>
        </div>
        <div class="cols cols--ruled">
          <div>
            {o.spec ? (
              <Theirs by="The job text, as the employer wrote it" text={o.spec} />
            ) : (
              <p class="small">
                The job text is published once, in the order's OrderOpened log. That log is older than this
                server can read without an indexer, so only its hash is shown.
              </p>
            )}
            <div class="tablewrap">
              <table class="kv">
                <tbody>
                  <tr>
                    <th scope="row">Employer</th>
                    <td class="code">{o.employer}</td>
                  </tr>
                  {m.kind && (
                    <tr>
                      <th scope="row">Kind</th>
                      <td class="code">{m.kind}</td>
                    </tr>
                  )}
                  {o.terms && (
                    <>
                      <tr>
                        <th scope="row">Job text hash</th>
                        <td class="code">{o.terms.specHash}</td>
                      </tr>
                      {!m.delivered && (
                        <tr>
                          <th scope="row">Expires</th>
                          <td>{formatUtc(o.terms.expiresAt * 1000)}</td>
                        </tr>
                      )}
                      <tr>
                        <th scope="row">Delivery window</th>
                        <td>{formatDuration(o.terms.deliverySecs * 1000)} after the job is registered</td>
                      </tr>
                      <tr>
                        <th scope="row">Pays on</th>
                        <td>
                          {o.terms.flags & 1
                            ? "a receipt, or a bonded claim nobody challenges within 24 hours"
                            : "an on-chain receipt only"}
                        </td>
                      </tr>
                      {(o.terms.flags & 1) !== 0 && (
                        <tr>
                          <th scope="row">Arbiter</th>
                          <td class="code">
                            {o.terms.arbiter ?? "none: only a receipt can decide a challenged claim"}
                          </td>
                        </tr>
                      )}
                      {o.terms.condTarget && (
                        <tr>
                          <th scope="row">Condition</th>
                          <td class="code">
                            {o.terms.condTarget} {o.terms.condSelector}:{" "}
                            {o.terms.condMet ? "seen true" : "not yet seen true"}
                          </td>
                        </tr>
                      )}
                    </>
                  )}
                  {o.claim?.jobId && (
                    <tr>
                      <th scope="row">Swarm job</th>
                      <td class="code">
                        <a href={m.jobUrl} rel="noopener">
                          {o.claim.jobId}
                        </a>{" "}
                        · <a href={m.verifyPath}>verify</a>
                      </td>
                    </tr>
                  )}
                  {o.claim?.recordHash && (
                    <tr>
                      <th scope="row">Record hash</th>
                      <td class="code">{o.claim.recordHash}</td>
                    </tr>
                  )}
                  {m.ticket && (
                    <tr>
                      <th scope="row">Ticket</th>
                      <td class="code">{m.ticket}</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
          <div class="tablewrap">
            <table>
              <caption>Money</caption>
              <thead>
                <tr>
                  <th />
                  <th class="num">IMD</th>
                </tr>
              </thead>
              <tbody>
                {m.money.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td class="num">{row.imd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </>
  )}

  {m.proof && (
    <section class="section" id="proof">
      <div class="section__head">
        <h2>The proof</h2>
        <p>WorkProof.prove · a call, not a transaction · no key needed</p>
      </div>
      <Commands commands={m.proof.commands} />
      {m.proof.printed && (
        <>
          <p class="small">
            {m.proof.source === "live" ? "It answers, called for this page:" : "It answered, as pinned:"}
          </p>
          <div class="cmd cmd--plain">
            <div class="cmd__row">
              <pre class="break">{m.proof.printed}</pre>
            </div>
          </div>
        </>
      )}
      <p>{m.proof.words}</p>
    </section>
  )}

  {m.tips.length > 0 && (
    <section class="section" id="tip">
      <div class="section__head">
        <h2>The tip</h2>
        <p>agent → seat → the seat's owner, read live</p>
      </div>
      <ul>
        {m.tips.map((tip) => (
          <li>
            <strong>Agent {tip.agentId}</strong> → {tip.seat !== null ? `seat #${tip.seat}` : "no seat read"}{" "}
            → {tip.owner ? <span class="data break">{tip.owner}</span> : "owner unread"}{" "}
            <span class="small">(the seat Adapter's bindingOf, then the seat token's ownerOf)</span>.{" "}
            {tip.words}
            {tip.claimed && (
              <>
                {" "}
                <a href={tip.claimed.txUrl} rel="noopener">
                  The claim.
                </a>
              </>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(m.picture || m.mediaCid || m.work) && (
    <section class="section" id="work">
      <div class="section__head">
        <h2>The work</h2>
        <p>as IdentityMD lists it</p>
      </div>
      {/* The key that opens the work is printed once, in the page head; this section says what it
           opens. */}
      {m.picture && (
        <p class="small">
          The link opens IdentityMD's page of the job, which shows it. This site serves no copy.
        </p>
      )}
      {m.work && <p class="small">{m.work.what} This site serves no copy.</p>}
      {m.mediaCid && (
        <>
          <p>
            IdentityMD's API gives the job's media this IPFS CID (<code>media.cid</code>).
          </p>
          <p class="data break">{m.mediaCid}</p>
        </>
      )}
    </section>
  )}

  <section class="section">
    <div class="section__head">
      <h2>Check it yourself</h2>
      <p>every signature read from the ABI the compiler wrote · no key needed</p>
    </div>
    <Commands commands={m.commands} />
  </section>

  {m.flows.length > 0 && (
    <section class="section">
      <div class="section__head">
        <h2>What anyone can do</h2>
        <p>no privileged caller exists</p>
      </div>
      {m.flows.map((flow, index) => (
        <FlowBlock flow={flow} exampleNote={`order ${m.id}`} repeat={index > 0} />
      ))}
    </section>
  )}
</Layout>
