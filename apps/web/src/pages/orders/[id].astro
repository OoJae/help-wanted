---
import Commands from "~/components/Commands.astro";
import FlowBlock from "~/components/FlowBlock.astro";
import NotLaunched from "~/components/NotLaunched.astro";
import Stamp from "~/components/Stamp.astro";
import Theirs from "~/components/Theirs.astro";
import Layout from "~/layouts/Layout.astro";
import { formatDuration, formatUtc } from "~/lib/format";
import { pageData } from "~/lib/page";
import type { OrderModel } from "~/models/desk";

const loaded = await pageData<OrderModel>(Astro);
if (loaded instanceof Response) return loaded;
const { model: m, meta } = loaded;
const o = m.order;
const c = m.card;
---

<Layout title={meta.title} description={meta.description} sources={m.sources} generatedAt={m.generatedAt}>
  <header class="pagehead">
    <p class="crumbs">
      <a href="/orders">Orders</a> · order {m.id}
      {c && (
        <>
          {" "}
          · <span class:list={["tag", c.origin === "HOUSE" && "tag--solid"]}>{c.origin}</span>
        </>
      )}
      {c?.sample && (
        <>
          {" "}
          <span class="tag tag--spot">SAMPLE</span>
        </>
      )}
    </p>
    <div class="lost">
      <div>
        <h1 class="headline headline--small">
          {c
            ? `${c.headline} ${c.pay} ${c.employerWords}`
            : m.launched
              ? `Order ${m.id} could not be read just now.`
              : `Order ${m.id} does not exist yet.`}
        </h1>
        <p class="deck">{m.statusWords}</p>
      </div>
      {c?.stamp && (
        <p class="release__stamp">
          <Stamp stamp={c.stamp} big />
        </p>
      )}
    </div>
  </header>

  <NotLaunched contract={m.desk} consequence="No order exists on chain." />
  {m.error && <p class="small spot">The desk could not be read just now: {m.error}</p>}

  {o && (
    <>
      <section class="section section--first">
        <div class="section__head">
          <h2>Timeline</h2>
          <p>posted, taken, job opened, delivered, proven</p>
        </div>
        <ol class="timeline">
          {m.timeline.map((step) => (
            <li data-at={step.at}>
              <span class="label">{step.label}</span>
              <p>{step.detail}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="section">
        <div class="section__head">
          <h2>The order</h2>
          <p>read from the desk</p>
        </div>
        <div class="cols cols--ruled">
          <div>
            {o.spec ? (
              <Theirs by="The job text, as the employer wrote it" text={o.spec} />
            ) : (
              <p class="small">
                The job text is published once, in the order's OrderOpened log. That log is older than this
                server can read without an indexer, so only its hash is shown.
              </p>
            )}
            <div class="tablewrap">
              <table class="kv">
                <tbody>
                  <tr>
                    <th scope="row">Employer</th>
                    <td class="code">{o.employer}</td>
                  </tr>
                  {m.kind && (
                    <tr>
                      <th scope="row">Kind</th>
                      <td class="code">{m.kind}</td>
                    </tr>
                  )}
                  {o.terms && (
                    <>
                      <tr>
                        <th scope="row">Job text hash</th>
                        <td class="code">{o.terms.specHash}</td>
                      </tr>
                      <tr>
                        <th scope="row">Expires</th>
                        <td>{formatUtc(o.terms.expiresAt * 1000)}</td>
                      </tr>
                      <tr>
                        <th scope="row">Delivery window</th>
                        <td>{formatDuration(o.terms.deliverySecs * 1000)} after the job is registered</td>
                      </tr>
                      <tr>
                        <th scope="row">Pays on</th>
                        <td>
                          {o.terms.flags & 1
                            ? "a receipt, or a bonded claim nobody challenges within 24 hours"
                            : "an on-chain receipt only"}
                        </td>
                      </tr>
                      {(o.terms.flags & 1) !== 0 && (
                        <tr>
                          <th scope="row">Arbiter</th>
                          <td class="code">
                            {o.terms.arbiter ?? "none: only a receipt can decide a challenged claim"}
                          </td>
                        </tr>
                      )}
                      {o.terms.condTarget && (
                        <tr>
                          <th scope="row">Condition</th>
                          <td class="code">
                            {o.terms.condTarget} {o.terms.condSelector}:{" "}
                            {o.terms.condMet ? "seen true" : "not yet seen true"}
                          </td>
                        </tr>
                      )}
                    </>
                  )}
                  {o.claim?.jobId && (
                    <tr>
                      <th scope="row">Swarm job</th>
                      <td class="code">
                        <a href={m.jobUrl} rel="noopener">
                          {o.claim.jobId}
                        </a>{" "}
                        · <a href={m.verifyPath}>verify</a>
                      </td>
                    </tr>
                  )}
                  {o.claim?.recordHash && (
                    <tr>
                      <th scope="row">Record hash</th>
                      <td class="code">{o.claim.recordHash}</td>
                    </tr>
                  )}
                  {m.ticket && (
                    <tr>
                      <th scope="row">Ticket</th>
                      <td class="code">{m.ticket}</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
          <div class="tablewrap">
            <table>
              <caption>Money</caption>
              <thead>
                <tr>
                  <th />
                  <th class="num">IMD</th>
                </tr>
              </thead>
              <tbody>
                {m.money.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td class="num">{row.imd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </>
  )}

  <section class="section">
    <div class="section__head">
      <h2>Check it yourself</h2>
      <p>every signature read from the ABI the compiler wrote · no key needed</p>
    </div>
    <Commands commands={m.commands} />
  </section>

  <section class="section">
    <div class="section__head">
      <h2>What anyone can do</h2>
      <p>no privileged caller exists</p>
    </div>
    {m.flows.map((flow, index) => (
      <FlowBlock flow={flow} exampleNote={`order ${m.id}`} repeat={index > 0} />
    ))}
  </section>
</Layout>
