---
import Commands from "~/components/Commands.astro";
import FlowBlock from "~/components/FlowBlock.astro";
import NotLaunched from "~/components/NotLaunched.astro";
import NotLive from "~/components/NotLive.astro";
import Layout from "~/layouts/Layout.astro";
import { pageData } from "~/lib/page";
import { seatTipPaidWords, type SeatModel } from "~/models/money";
import { imdReviewWords, seatReviewWaitingWords, seatReviewWords } from "~/models/reviews";

const loaded = await pageData<SeatModel>(Astro);
if (loaded instanceof Response) return loaded;
const { model: m, meta } = loaded;
---

<Layout title={meta.title} description={meta.description} sources={m.sources} generatedAt={m.generatedAt}>
  <header class="pagehead">
    <p class="crumbs">
      <a href="/seats">Seats</a> · seat {m.tokenId} of 2,000
    </p>
    <h1 class="headline headline--small">Seat #{m.tokenId}</h1>
    <dl class="figures">
      <div class="figure figure--wide">
        <dt>Owner</dt>
        <dd class="figure__data">
          {m.owner ? (
            <a href={m.ownerUrl} rel="noopener">
              {m.owner}
            </a>
          ) : (
            "could not be read"
          )}
        </dd>
        <span class="note">ownerOf, read live</span>
      </div>
      <div class="figure">
        <dt>Bound agent</dt>
        <dd class="figure__words">
          {m.agents.length > 0 ? m.agents.map((a) => `#${a}`).join(", ") : "none seen"}
        </dd>
        <span class="note">
          {m.agents.length > 0 ? "seen in a checked work record" : "the Adapter answers agent to seat only"}
        </span>
      </div>
      <div class="figure">
        <dt>Claimable</dt>
        <dd class="figure__words">
          {m.claimableImd !== null
            ? `${m.claimableImd} IMD`
            : m.launched
              ? "could not be read"
              : "not launched yet"}
        </dd>
        <span class="note">its share of the seat pool</span>
      </div>
      {m.paidImd !== null && (
        <div class="figure">
          <dt>Paid from the seat pool</dt>
          <dd class="figure__words">{m.paidImd} IMD</dd>
          <span class="note">seatPaid, read from Payroll; tips not counted</span>
        </div>
      )}
      {m.tipsPaidImd !== null && (
        <div class="figure">
          <dt>Tips paid to its owner</dt>
          <dd class="figure__words">{m.tipsPaidImd} IMD</dd>
          <span class="note">claimTip, orders on record here</span>
        </div>
      )}
    </dl>
  </header>

  <NotLaunched
    contract={m.payroll}
    consequence="This seat has nothing to claim yet. Its owner is read live."
  />
  <NotLive notes={m.notLive} />
  {m.ownerError && <p class="small spot">The owner could not be read just now: {m.ownerError}</p>}
  {m.claimError && <p class="small spot">Payroll could not be read just now: {m.claimError}</p>}

  {m.agents.length === 0 && (
    <p>
      IdentityMD's Adapter maps an agent to its seat, not a seat to its agent. So this site can name a seat's
      agent only after that agent has turned up in a work record it checked.{" "}
      <a href="/seats">Look an agent up directly.</a>
    </p>
  )}
  {m.tips.length > 0 && (
    <div class="tablewrap">
      <table>
        <caption>Tips waiting for this seat's agents</caption>
        <thead>
          <tr>
            <th>Agent</th>
            <th class="num">Tips waiting</th>
          </tr>
        </thead>
        <tbody>
          {m.tips.map((tip) => (
            <tr>
              <th scope="row">Agent {tip.agentId}</th>
              <td class="num">
                {tip.owedImd !== null
                  ? `${tip.owedImd} IMD`
                  : m.launched
                    ? "could not be read"
                    : "not launched yet"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {m.tipsPaid.length > 0 && (
    <section class="section">
      <div class="section__head">
        <h2>Tips paid to this seat's owner</h2>
        <p>agent id → seat → owner, at the time of the claim</p>
      </div>
      <p>{m.tipsPaidNote}</p>
      <ul>
        {m.tipsPaid.map((tip) => (
          <li>
            {seatTipPaidWords(tip)}{" "}
            <a href={tip.txUrl} rel="noopener">
              Transaction
            </a>
            .
          </li>
        ))}
      </ul>
    </section>
  )}

  {m.reviews && (
    <section class="section">
      <div class="section__head">
        <h2>Reviews on ERC-8004</h2>
        <p>IdentityMD's first, then ours · read live</p>
      </div>
      <p>{m.reviewsNote}</p>
      <p class="small">
        <a href={m.reviews.registryUrl} rel="noopener">
          The registry
        </a>{" "}
        ·
        <a href={m.reviews.imdClientUrl} rel="noopener">
          IdentityMD's WorkRegistry
        </a>
      </p>
      <h3 class="sub">IdentityMD's</h3>
      {m.reviews.imd.map((imd) => (
        <>
          <p>{imdReviewWords(imd)}</p>
          {imd.categories.length > 0 && (
            <div class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th>Category (tag1)</th>
                    <th class="num">Reviews</th>
                    <th class="num">Value 1</th>
                  </tr>
                </thead>
                <tbody>
                  {imd.categories.map((c) => (
                    <tr>
                      <td class="code">{c.category}</td>
                      <td class="num">{c.count}</td>
                      <td class="num">{c.accepted}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      ))}
      {m.reviews.ours && (
        <>
          <h3 class="sub">Ours</h3>
          {m.reviews.ours.error ? (
            <p class="small spot">Our reviews could not be read just now: {m.reviews.ours.error}</p>
          ) : m.reviews.ours.entries.length === 0 ? (
            <p>None yet.</p>
          ) : (
            <ul>
              {m.reviews.ours.entries.map((e) => (
                <li>
                  <span class:list={["tag", e.origin === "HOUSE" && "tag--solid"]}>{e.origin}</span>{" "}
                  {seatReviewWords(e)} <a href={e.fileUrl}>Feedback file</a> ·
                  <a href={e.paymentTxUrl} rel="noopener">
                    payment
                  </a>{" "}
                  ·
                  <a href={e.settlementTxUrl} rel="noopener">
                    settlement
                  </a>
                  {e.log && (
                    <>
                      ·{" "}
                      <a href={e.log.txUrl} rel="noopener">
                        review
                      </a>
                    </>
                  )}
                </li>
              ))}
            </ul>
          )}
          {m.reviews.ours.waiting.length > 0 && (
            <ul>
              {m.reviews.ours.waiting.map((w) => (
                <li>
                  {seatReviewWaitingWords(w)} <a href={w.fileUrl}>Feedback file</a>.
                </li>
              ))}
            </ul>
          )}
        </>
      )}
    </section>
  )}

  <section class="section">
    <div class="section__head">
      <h2>Check it yourself</h2>
      <p>no key needed</p>
    </div>
    <Commands commands={m.commands} />
  </section>

  <section class="section">
    <div class="section__head">
      <h2>Claim</h2>
      <p>the IMD goes to the owner · a contract that holds a seat claims for itself</p>
    </div>
    <p>{m.claimRule}</p>
    {m.flows.map((flow, index) => (
      <FlowBlock flow={flow} exampleNote={`seat ${m.tokenId}`} repeat={index > 0} />
    ))}
  </section>
</Layout>
