---
import Commands from "~/components/Commands.astro";
import FlowBlock from "~/components/FlowBlock.astro";
import NotLaunched from "~/components/NotLaunched.astro";
import OrderCard from "~/components/OrderCard.astro";
import Layout from "~/layouts/Layout.astro";
import { pageData } from "~/lib/page";
import { heartbeatFigures, type RunnersModel } from "~/models/desk";

const loaded = await pageData<RunnersModel>(Astro);
if (loaded instanceof Response) return loaded;
const { model: m, meta } = loaded;
// The hosted runner's heartbeat: when its wallet last acted on the desk, and what it serves.
const beat = m.heartbeat;
const beatFigures = beat ? heartbeatFigures(beat) : [];
---

<Layout title={meta.title} description={meta.description} sources={m.sources} generatedAt={m.generatedAt}>
  <header class="pagehead">
    <h1 class="headline headline--wide">
      Take an order. Carry it to the swarm. Get paid on proof, or on a claim that stands.
    </h1>
    {/* The deck says it in a line; the reasoning in full, and who runs one, follow what a runner
         does, under "Why there are runners". */}
    <p class="deck">
      IdentityMD bills up front; the desk pays later. A runner fronts the swarm's fee in between, under bond,
      for a margin.
    </p>
  </header>

  <NotLaunched contract={m.desk} consequence="There are no orders to take." />
  {m.launched && <p class:list={["small", m.count === null && "spot"]}>{m.openWords}</p>}
  {m.error && m.count !== null && (
    <p class="small spot">The desk's last read came with an error: {m.error}</p>
  )}

  {beat && (
    <section class="section section--first beat" id="runner" aria-labelledby="runner-now">
      <div class="section__head">
        <h2 id="runner-now">The team's runner, now</h2>
        <p>
          house wallet{" "}
          <a class="addr" href={beat.wallet.url} rel="noopener">
            {beat.wallet.label}
          </a>
        </p>
      </div>
      {beatFigures.length > 0 && (
        <dl class="figures beat__figures">
          {beatFigures.map((f, index) => (
            <div
              class:list={[
                "figure",
                index === 0 && beat.seenAt && "beat__seen",
                // The time and the list of kinds take a whole row on a phone; the two counts share one.
                ((index === 0 && beat.seenAt) || f.value.includes(", ")) && "figure--wide",
              ]}
            >
              <dt>{f.label}</dt>
              {index === 0 && beat.seenAt ? (
                <dd class="figure__words">{f.value}</dd>
              ) : f.value.length > 3 ? (
                <dd class="figure__data">
                  {/* A list of kinds, one to a line, so no name breaks inside itself. */}
                  {f.value.split(", ").map((part, i, all) => (
                    <span class="beat__kind">{i < all.length - 1 ? `${part},` : part}</span>
                  ))}
                </dd>
              ) : (
                <dd>{f.value}</dd>
              )}
              {f.note && <span class="note">{f.note}</span>}
            </div>
          ))}
        </dl>
      )}
      {/* prettier-ignore */}
      <p class="small beat__words">{beat.words}{beat.tx && <> <a href={beat.tx.url} rel="noopener">{beat.tx.label[0]!.toUpperCase() + beat.tx.label.slice(1)}</a>.</>}</p>
      {beat.servesNote && <p class="small">{beat.servesNote}</p>}
    </section>
  )}

  {m.open.length > 0 && (
    <section class:list={["section", !beat && "section--first"]}>
      <div class="section__head">
        <h2>Open orders</h2>
        <p>{m.open.length} waiting for a runner</p>
      </div>
      <div class="classifieds">
        {m.open.map((card) => (
          <OrderCard card={card} />
        ))}
      </div>
    </section>
  )}

  <section class:list={["section", m.open.length === 0 && !beat && "section--first"]}>
    <div class="section__head">
      <h2>What a runner does</h2>
      <p>the open-source runner is in the repository under bots/runner</p>
    </div>
    <div class="cols cols--ruled">
      <ol>
        {m.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <div>
        <h3 class="sub sub--first">What it earns</h3>
        <ul>
          {m.economics.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
        <h3 class="sub">What it risks</h3>
        <ul>
          {m.risks.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="why">
    <div class="section__head">
      <h2>Why there are runners</h2>
      <p>and who takes orders today</p>
    </div>
    <p>
      {m.why} {m.whoRuns}
    </p>
    <div class="cols cols--ruled">
      <aside class="notice" aria-label="Who takes orders today">
        <span class="label">Who takes orders today</span>
        <p>
          {m.runnerStatement && <strong>What the chain shows: </strong>}
          {m.whoTakes}
        </p>
        {m.runnerStatement && (
          <>
            <p class="small">
              <strong>{m.runnerStatement.heading}.</strong> A statement, not a reading:
            </p>
            <ul class="small">
              {m.runnerStatement.lines.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </>
        )}
      </aside>
      <aside class="notice notice--quiet" aria-label="Who this is for">
        <span class="label">Who this is for</span>
        <ul>
          {m.whoFor.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>The 85-byte order header</h2>
      <p>{m.headerExample.bytes} bytes, the last a space</p>
    </div>
    <p>
      The job a runner opens must begin with the 85-byte order header, built from the order's ticket, then the
      order's job text. For ticket <code class="break">{m.headerExample.ticket}</code>:
    </p>
    <div class="cmd cmd--plain">
      <div class="cmd__row">
        <pre>{m.headerExample.header}</pre>
      </div>
    </div>
    <p class="small">
      ticket = keccak256(abi.encode(chainId, workOrders, orderId, claimSeq, runner)). claimSeq counts claims
      of that order from 1, so a second runner gets a different ticket and an old receipt cannot be used
      twice. The desk returns the 85 bytes for a claimed order with headerOf(id).
    </p>
  </section>

  <section class="section" id="steps">
    <div class="section__head">
      <h2>The on-chain steps</h2>
      <p>buying the job itself is done by the runner bot, not from a browser</p>
    </div>
    <aside class="notice" aria-label="Receipts now">
      <span class="label">Receipts, read for this page</span>
      <p>{m.receiptsNow}</p>
    </aside>
    {m.flows.map((flow, index) => (
      <FlowBlock flow={flow} exampleNote="order 1" repeat={index > 0} />
    ))}
    <h3 class="sub" id="settle">
      Being paid on a receipt
    </h3>
    <p>
      The record itself is the transaction's argument, so these are commands for a terminal; the runner bot
      sends the same call.
    </p>
    <Commands commands={m.settleCommands} />
  </section>
</Layout>
