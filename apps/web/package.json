{
  "name": "@help-wanted/web",
  "version": "0.1.0",
  "private": true,
  "description": "The HELP WANTED site: the Work Wire, the receipt checker, the Robot Jobs Report and the hire desk, server-rendered so that a plain HTTP client reads every page whole.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@help-wanted/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.4",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
