# HELP WANTED web app. Every variable is optional: with none set, the server reads the public
# IdentityMD API and a public Ethereum RPC, and shows each of our own contracts as the shared
# deployments book has it: at its address once its launch is written there, "not launched yet"
# until then.
# All of them are read when the server starts, never at build time, so one build runs anywhere.

# Where the site is served from, without a trailing slash. Used only for absolute links in
# /llms.txt, /sitemap.xml, /robots.txt, the canonical link and the commands printed on /judges. On
# Railway, RAILWAY_PUBLIC_DOMAIN is used when this is not set. With neither, the site prints no
# address of its own: pages carry no canonical link and /sitemap.xml answers 404 (a warning is
# logged at start). It never builds one from the request's Host header.
SITE_ORIGIN=

# The port and address the server listens on (Railway sets PORT).
PORT=4321
HOST=0.0.0.0

# JSON-RPC endpoint for eth_call and recent logs. Default: https://ethereum-rpc.publicnode.com
# It may carry a key: commands printed for readers always name the public endpoint, never this one.
RPC_URL=

# How many blocks back RPC_URL serves eth_getLogs. The public default serves about one day.
RPC_LOG_WINDOW_BLOCKS=7200

# The most requests a minute this server sends to RPC_URL, for all visitors together. Reads a
# visitor can cause one by one (a new job id, a seat, an order) get three quarters of it.
RPC_MAX_PER_MINUTE=240

# An RPC that answers eth_getLogs over long ranges. The Jobs Report's headline figures are always
# for the newest 7,200 blocks, whatever is set here. With an archive RPC its table of earlier days
# reaches back TALLY_DAYS days; without one it shows only what this process has read while running.
ARCHIVE_RPC_URL=
TALLY_DAYS=14

# The IdentityMD public API, and the most requests a minute this server sends to it for all
# visitors together (the API allows 120 a minute; keep this far below).
IMD_API_BASE=https://api.imd.fun
IMD_API_MAX_PER_MINUTE=40

# The request header that carries the visitor's address, for the per-visitor limit on new receipt
# checks (12 a minute). Leave empty to use the socket's own address. Set it only to a header your
# proxy overwrites on every request. On Railway it defaults to x-real-ip, which Railway's edge sets.
CLIENT_IP_HEADER=

# The keeper bot's status file (bots/keeper writes it after every pass; it holds nothing secret).
# Give a path when the keeper runs on the same machine, or an address when it does not. With
# neither, the questions page says that no keeper status is connected.
KEEPER_STATUS_PATH=
KEEPER_STATUS_URL=

# The addresses of our own contracts. The place to fill in after a launch is the deployments book
# of the shared package (DEPLOYMENT_BOOK in packages/shared/src/deployments.ts), which the bots and
# this site all read; these override it without a rebuild (for a fork or a rehearsal). Anything that is not an address
# is ignored. An address that does not answer as the contract (IMD(), WORK_REGISTRY() or QUESTIONS()
# with the expected value) is shown, but its wallet buttons stay off; /api/v1/status reports each.
HW_ADDR_QUESTIONS=
HW_ADDR_JOBS_REPORT=
HW_ADDR_PAYROLL=
HW_ADDR_WORK_PROOF=
HW_ADDR_WORK_ORDERS=
HW_ADDR_CROWD_POTS=
HW_ADDR_DOORBELL=
HW_ADDR_RULES=
HW_ADDR_ENDOWMENTS=
HW_ADDR_ZAP=

# Shown in the footer and in /api/v1/status.
REPO_URL=
X_HANDLE=

# Design aid only. When set to 1, orders and pots are replaced by made-up ones, every page carries
# a SAMPLE DATA banner and every sample item is marked. Never set this on a public deployment.
HW_SAMPLE_DATA=
