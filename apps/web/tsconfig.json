{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Astro and Vite resolve modules themselves; NodeNext from the base config would demand ".js"
    // suffixes that neither tool wants in a bundled app.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["astro/client", "node"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "test/**/*", "astro.config.mjs", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
